POSTGRES_DB=devmind
POSTGRES_USER=devmind
POSTGRES_PASSWORD=devmind123
DEVMIND_PROFILE=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEVMIND_EMBEDDING_DIMENSIONS=1536
DEVMIND_MODEL_MODE=mock

DEVMIND_SQL_DIAGNOSIS_MODE=mock
DEVMIND_SQL_JDBC_URL=
DEVMIND_SQL_USERNAME=
DEVMIND_SQL_PASSWORD=

DEVMIND_MODEL_FALLBACK_BASE_URL=
DEVMIND_MODEL_FALLBACK_API_KEY=
DEVMIND_MODEL_FALLBACK_CHAT_MODEL=
DEVMIND_COST_PROMPT_PER_1K=0.00015
DEVMIND_COST_COMPLETION_PER_1K=0.0006

# ===== 检索与任务（可选，有默认值） =====
DEVMIND_RETRIEVAL_TOP_K=5
DEVMIND_RETRIEVAL_MAX_TOP_K=10
DEVMIND_RETRIEVAL_MIN_SCORE=0.35
DEVMIND_RETRIEVAL_VECTOR_WEIGHT=0.7
DEVMIND_RETRIEVAL_KEYWORD_WEIGHT=0.3
DEVMIND_RETRIEVAL_HYBRID_ENABLED=true
DEVMIND_RERANK_MODE=heuristic
DEVMIND_LOCAL_RAG_FALLBACK=true
DEVMIND_CHUNKER_STRATEGY=boundary
DEVMIND_MAX_CHUNK_CHARS=1500
DEVMIND_OVERLAP_CHARS=200
DEVMIND_TASK_MAX_RETRIES=3
DEVMIND_TASK_RETRY_DELAY_MS=5000
DEVMIND_TASK_TIMEOUT_MINUTES=5
DEVMIND_TASK_SCAN_INTERVAL_MS=60000
DEVMIND_TASK_THREAD_POOL_SIZE=4

# ===== 安全（项目不上线，保持免登录演示；如需开启设为 true） =====
DEVMIND_AUTH_ENABLED=false
DEVMIND_LOGIN_MAX_FAILURES=5
DEVMIND_LOGIN_LOCK_MINUTES=10
DEVMIND_RATE_LIMIT_PER_MINUTE=120
DEVMIND_RATE_LIMIT_LOGIN_PER_MINUTE=10
DEVMIND_TOKEN_TTL_DAYS=7
DEVMIND_SECRET_MASTER_KEY=

# ===== 用量配额（0=不限制） =====
DEVMIND_QUOTA_DAILY_CALLS=0
DEVMIND_QUOTA_DAILY_COST=0

